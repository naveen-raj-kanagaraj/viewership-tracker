# Everything here is optional. The tracker runs with no configuration at all:
# viewer counts come from public YouTube pages through yt-dlp.
# Copy this file to .env and fill in only what you need.

# ---------- counting ----------
# With a YouTube Data API key, counts come from the official API instead of the
# public pages: more exact, and one quota unit per 50 streams.
YOUTUBE_API_KEY=

EVENT_FAST_SEC=2          # how often live streams are re-counted
EVENT_POLL_SEC=60         # how often YouTube is searched for new streams
EVENT_TZ=Asia/Kolkata     # timezone for day boundaries and reports

# A jump or drop of at least EVENT_ANOMALY_MIN viewers that is also at least
# EVENT_ANOMALY_PCT of the stream, inside ~15 seconds, is recorded as an anomaly.
EVENT_ANOMALY_MIN=2000
EVENT_ANOMALY_PCT=0.15

# ---------- dashboard ----------
EVENT_WEB_PORT=8092
EVENT_PUBLIC_URL=          # canonical URL, used in share cards and OG images
EVENT_BRAND=               # brand name shown on the dashboard
EVENT_BRAND_URL=

# A public link through cloudflared, so the dashboard is shareable without a server.
EVENT_PUBLIC_LINK=true
EVENT_TUNNEL_NAME=         # named tunnel; blank uses a quick tunnel

# ---------- optional Telegram notifications ----------
# Only used to send the public link and daily log files. Leave blank to skip.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# ---------- Predict & Win ----------
PREDICT_OPEN=0            # 1 opens the prediction game, 0 serves the crowd results page
PREDICT_MAX_PER_IP=1
PREDICT_SPLIT=1

# ---------- storage ----------
TRACKER_DB=data/tracker.db

# Kick and Twitch (optional; per event with `track.py kick|twitch <event> ...`). Never commit real values.
# Twitch: dev.twitch.tv/console -> Register Your Application (category: Analytics Tool), then New Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kick: kick.com -> Settings -> Developer -> Create app. Without these, Kick is read from its public channel pages.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# How often Kick/Twitch counts are refreshed (they update about every 30-60s on the platforms themselves)
PLATFORM_COUNT_SEC=15
